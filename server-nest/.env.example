# ─────────────────────────────────────────────────────────────
# Facial.io — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. This file is safe to commit.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ── MongoDB ────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/facialio
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/facialio
MONGODB_URI=mongodb://localhost:27017/facialio

# ── Clerk ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
# sk_test_... for development, sk_live_... for production
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Pinecone ───────────────────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
# Free tier: 1 index, 100K vectors — more than enough for a demo
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=facialio

# ── Google Gemini ──────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day — no card required
GEMINI_API_KEY=your_gemini_api_key_here

# ── Stripe (TEST MODE — no real charges) ───────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
# Use sk_test_... keys only during development
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Create products/prices in Stripe dashboard, then paste the Price IDs here
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# ── Resend ─────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Free tier: 3,000 emails/month — no card required
RESEND_API_KEY=re_your_resend_key_here

# ── Twilio (WhatsApp + SMS alerts) ────────────────────────────
# Get from: https://console.twilio.com → Account Info
# For WhatsApp dev: use the Twilio Sandbox (whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A Twilio phone number for SMS (e.g. +15005550006 in test mode)
TWILIO_FROM_SMS=+15005550006
# WhatsApp-enabled sender (sandbox: whatsapp:+14155238886)
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
# Admin WhatsApp number for daily summaries (e.g. whatsapp:+919876543210)
TWILIO_ADMIN_WHATSAPP=whatsapp:+919876543210
